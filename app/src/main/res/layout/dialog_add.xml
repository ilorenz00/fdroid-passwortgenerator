<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/editText_domain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/domain_hint"
        android:inputType="textUri"
        android:singleLine="true"
        android:importantForAutofill="no"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/editText_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/username_hint"
        android:inputType="textPersonName"
        android:singleLine="true"
        android:importantForAutofill="no"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/password_consists_of"
        android:textSize="14sp"
        android:textColor="@color/colorCardSubtext" />

    <CheckBox
        android:id="@+id/checkbox_lower"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/checkbox_lower"
        android:checked="true" />

    <CheckBox
        android:id="@+id/checkbox_upper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/checkbox_upper"
        android:checked="true" />

    <CheckBox
        android:id="@+id/checkbox_numbers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/checkbox_numbers"
        android:checked="true" />

    <CheckBox
        android:id="@+id/checkbox_special"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/checkbox_special"
        android:checked="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/length_heading"
        android:textSize="14sp"
        android:textColor="@color/colorCardSubtext" />

    <SeekBar
        android:id="@+id/seekbar_length"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="30"
        android:progress="10"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/btn_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="16dp"
        android:text="@string/add" />
</LinearLayout>
